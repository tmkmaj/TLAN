# TLAN egress gateway configuration (YAML, strict: unknown keys are rejected).
#
# Keep this file readable only by the service account. It contains no lease
# secrets, but it does describe the egress interface and target policy.
#
# The gateway is an egress, not an open proxy: loopback, private, link-local,
# multicast, unspecified and cloud-metadata targets are always rejected by the
# policy layer, even when allow_cidrs is broad.

listen: "0.0.0.0:7443"
state_dir: "/var/lib/tlan-egress"

# TLS is mandatory for the data plane. Clients pin this CA, never skip verify.
tls_cert: "/etc/tlan-egress/tls/server.crt"
tls_key: "/etc/tlan-egress/tls/server.key"

control:
  # Empty = serve the lease API on a loopback listener derived by the binary.
  lease_url: ""
  lease_secret_file: "/etc/tlan-egress/lease-secret.txt"

egress:
  # Interface used for SNAT/masquerade. It must exist before the service starts.
  interface: "eth0"
  ipv4_cidr: "10.250.0.0/24"
  dns_servers: ["1.1.1.1"]
  # Currently the gateway always enables ip_forward and restores the previous
  # value on rollback. Setting this to false is rejected rather than ignored.
  enable_ip_forward: true

limits:
  max_sessions: 128
  max_connections_per_lease: 64
  max_bytes_per_lease: 10737418240
  # Recorded on the lease; rate enforcement is not implemented yet.
  max_rate_bps: 52428800

policy:
  allow_cidrs: ["0.0.0.0/0"]
  # These hard denies cannot be disabled in the first release.
  deny_private: true
  deny_metadata: true
  deny_ports: [22, 25, 445, 3389, 8443]
  # Supported: "block" only. "proxy" and "allow_public" are rejected by the gateway deployment.
  ipv6_policy: "block"
  # Supported: "remote" / "block". "local" is rejected. dns_servers is the DNS-destination allowlist; hostname resolution uses the gateway host resolver.
  dns_policy: "remote"
