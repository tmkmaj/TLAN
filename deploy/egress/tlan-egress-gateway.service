[Unit]
Description=TLAN application egress gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tlan-egress
Group=tlan-egress
ExecStart=/opt/tlan-egress/egress-gateway -config /etc/tlan-egress/egress-gateway.yaml
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tlan-egress
# NAT and ip_forward changes require CAP_NET_ADMIN. The gateway only manages
# rules it created and never flushes unrelated firewall state.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
