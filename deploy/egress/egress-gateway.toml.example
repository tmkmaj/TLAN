# TLAN egress gateway example configuration.
#
# This file is a starting point. Keep it readable only by the service account;
# it contains no lease secrets, but it does describe the egress interface and
# the target policy.
#
# Design notes:
#   * The gateway is an egress, not an open proxy: private, loopback,
#     link-local, multicast and cloud-metadata targets are rejected by policy
#     even when allow_cidrs is broad.
#   * NAT rules carry a product marker; rollback removes only those rules and
#     restores the previous ip_forward value.

listen = "0.0.0.0:7443"
state_dir = "/var/lib/tlan-egress"

# TLS is mandatory for the data plane. Clients pin the CA, never skip verify.
tls_cert = "/etc/tlan-egress/tls/server.crt"
tls_key  = "/etc/tlan-egress/tls/server.key"

[control]
# Optional lease control plane. When empty, leases are issued locally from
# lease_secret_file (private deployment mode).
lease_url = ""
lease_secret_file = "/etc/tlan-egress/lease-secret.txt"

[egress]
# Interface used for SNAT/masquerade. Must exist before the service starts.
interface = "eth0"
# Tunnel address pool; clients get one address per session.
ipv4_cidr = "10.250.0.0/24"
dns_servers = ["1.1.1.1"]
enable_ip_forward = true

[limits]
max_sessions = 128
max_connections_per_lease = 64
max_bytes_per_lease = 10737418240
max_rate_bps = 52428800

[policy]
# Broad allow list is filtered by the hard denies below.
allow_cidrs = ["0.0.0.0/0"]
deny_private = true
deny_metadata = true
deny_ports = [22, 25, 445, 3389, 8443]
ipv6_policy = "block"
dns_policy = "remote"
