[Unit]
Description=TLAN Private LAN Server
Documentation=https://github.com/your-org/tlan
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tlan
Group=tlan
WorkingDirectory=/var/lib/tlan
ExecStart=/opt/tlan/tlan-server
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
