[Unit]
Description=TmkNetworkLAN IP HTTPS gateway (Caddy)
After=network-online.target tmknetworklan.service
Wants=network-online.target tmknetworklan.service

[Service]
Type=simple
User=tmkhttps
Group=tmkhttps
WorkingDirectory=/var/lib/tmknetworklan-caddy
Environment=XDG_DATA_HOME=/var/lib/tmknetworklan-caddy
Environment=XDG_CONFIG_HOME=/var/lib/tmknetworklan-caddy
ExecStart=/opt/tmknetworklan/caddy run --config /opt/tmknetworklan/Caddyfile --adapter caddyfile
ExecReload=/opt/tmknetworklan/caddy reload --config /opt/tmknetworklan/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# File capability provides TCP 80 binding on CentOS 7/systemd 219.
# Do not add NoNewPrivileges: it prevents obtaining the file capability.

[Install]
WantedBy=multi-user.target
