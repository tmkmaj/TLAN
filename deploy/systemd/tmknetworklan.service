[Unit]
Description=TmkNetworkLAN control service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/lanmesh
ExecStart=/opt/tmknetworklan/tmknetworklan-server
Restart=on-failure
RestartSec=3
User=lanmesh
Group=lanmesh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# Directories are created by the installer (compatible with systemd 219).
# Configuration: /var/lib/lanmesh/tnlan-config.yml (created on first run).
# Server relays ciphertext and does not need a TUN device or CAP_NET_ADMIN.

[Install]
WantedBy=multi-user.target
